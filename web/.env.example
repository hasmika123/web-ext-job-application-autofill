# Base URL of the Dossier Spring API (server-side only — proxied by Next route
# handlers so the JWT stays in httpOnly cookies). No trailing slash.
# Local dev default is http://localhost:8080; set the deployed API URL in prod.
DOSSIER_API_URL=http://localhost:8080

# GA4 Measurement ID for web analytics (Phase 6.2). PUBLIC by design (gtag.js ships it in
# the page — there is NO api_secret here, unlike the extension). Leave blank to disable
# analytics entirely (gtag.js is then never loaded). e.g. NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
