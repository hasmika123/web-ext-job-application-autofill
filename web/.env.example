# Base URL of the Dossier Spring API (server-side only — proxied by Next route
# handlers so the JWT stays in httpOnly cookies). No trailing slash.
# Local dev default is http://localhost:8080; set the deployed API URL in prod.
DOSSIER_API_URL=http://localhost:8080

# GA4 Measurement ID for web analytics (Phase 6.2). PUBLIC by design (gtag.js ships it in
# the page — there is NO api_secret here, unlike the extension). e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Master analytics switch, separate from the ID so you can STAGE the ID above but keep
# analytics dark while testing. gtag.js loads ONLY when the ID is set AND this is "true".
# Default off. Flip to true (and redeploy) to start collecting.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
