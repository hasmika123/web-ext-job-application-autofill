# Staging environment for docker-compose.staging.yml (REAL-GAPS-C P3.2).
# Copy to ".env.staging" ON THE BOX, in a SEPARATE checkout from production, and fill in real values.
# NEVER commit the real file. PLACEHOLDERS ONLY below.
#
#   git clone <repo> ~/dossier-staging && cd ~/dossier-staging
#   cp .env.staging.example .env.staging && chmod 600 .env.staging && nano .env.staging
#   scripts/ops/deploy.sh --staging --build --dry-run     # then without --dry-run
#
# THE RULE: staging shares NOTHING with production. Every secret below is a NEW value generated
# for staging; a production secret copied here would make staging a way into production.
# Staging data is synthetic or demo data - never a copy of the production database.
# Full guide: DEPLOY.md section 5.5.

# ---------------------------------------------------------------------------
# Database (its own MySQL container and volume: dossier-staging_mysql-data)
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_staging_only_long_random

# JWT signing secret - generate a NEW one:  openssl rand -base64 64
JWT_BASE64_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# ---------------------------------------------------------------------------
# Hostnames. SSLIP_HOST is the base host (the name is historical); the compose file needs it and
# MAIL_BASE_URL is built from it. Staging is served by the shared edge Caddy on this host name;
# the route is added to the edge Caddyfile by the user (DEPLOY.md section 5.5), not by this repo.
# ---------------------------------------------------------------------------
SSLIP_HOST=staging.kiwiply.com
ACME_EMAIL=you@example.com
MAIL_BASE_URL=https://staging.kiwiply.com

# Hosts the web server treats as platform hosts (comma separated); staging's own name belongs here.
PLATFORM_HOSTS=staging.kiwiply.com

# Extension direct calls: staging has no published extension; leave the default or set a dev id.
CORS_ALLOWED_ORIGIN_PATTERNS=chrome-extension://*

# ---------------------------------------------------------------------------
# Safe defaults for a test box: nothing external runs unless you turn it on
# ---------------------------------------------------------------------------
# Nightly job-board reads, daily matches and the inbox poller are OFF (the poller cron "-" = never).
DOSSIER_JOBS_ENABLED=false
DOSSIER_INBOX_POLL_CRON=-
# AI off (no key). A tester who wants it adds a SEPARATE Gemini key with a low quota.
DOSSIER_AI_ENABLED=false
DOSSIER_AI_API_KEY=
# Stripe: TEST-mode keys only (sk_test_...), or blank to leave billing off. Never a live key here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_3MO=
# Demo accounts on: this is what testers sign in with. A nightly reset is on in the compose default.
DEMO_ENABLED=true
DEMO_PASSWORD=CHANGE_ME_demo_password_for_testers
# Organization features on, so enterprise screens can be checked before release.
ORGS_ENABLED=true

# ---------------------------------------------------------------------------
# Mail: blank = the API starts and sends nothing. To test mail, use a SEPARATE Brevo sender or a
# catch-all mailbox, never a real customer address.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---------------------------------------------------------------------------
# Service-to-service secrets - NEW values for staging (openssl rand -base64 32)
# ---------------------------------------------------------------------------
DOSSIER_INTERNAL_TOKEN=CHANGE_ME_new_value
DOSSIER_SCRAPE_TOKEN=CHANGE_ME_new_value
DOSSIER_TENANT_HOST_SECRET=CHANGE_ME_new_value
# Inbox key: needed only if the inbox is switched on; a NEW key, not production's.
DOSSIER_INBOX_KEY=

# Admin bootstrap: a staging-only admin. ADMIN_PASSWORD_HASH is a BCRYPT hash with every '$' doubled
# to '$$' (see .env.example). Blank = no admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Monitoring (optional): Healthchecks.io ping URL for staging deploys. Blank = no-op.
# ---------------------------------------------------------------------------
HC_DEPLOY_URL=
# Public URLs deploy.sh checks after a staging deploy (space separated; `url` or `url|text the body must
# contain`). Off until the edge route exists (DEPLOY.md section 5.5), e.g.:
# DEPLOY_SMOKE_URLS=https://staging.kiwiply.com/ https://api-staging.kiwiply.com/management/health|"status":"UP"
