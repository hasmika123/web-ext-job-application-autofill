{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheBackups",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::kiwiply-db-backups"
    },
    {
      "Sid": "UploadAndReadBackupsButNeverDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::kiwiply-db-backups/*"
    }
  ]
}
