# Kiwiply ops schedule (Phase 15.1) — installed as /etc/cron.d/kiwiply-ops (DEPLOY.md §5.1):
#   sudo install -m 644 scripts/ops/kiwiply-ops.cron /etc/cron.d/kiwiply-ops
# A file of its own in cron.d, so it never touches BeeCompete's crontabs on this shared box.
# Times are the box's clock, which is UTC (check: timedatectl). They sit clear of the API's
# own nightly jobs (job boards 02:00, mail expiry 03:30, job matches 04:00).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
REPO=/root/web-ext-job-application-autofill

# Nightly: dump the database and ship it off the box.
15 3 * * * root "$REPO/scripts/ops/backup-db.sh" >> /var/log/kiwiply-backup.log 2>&1

# Weekly, Sunday: restore the newest backup into a throwaway container and check it.
45 4 * * 0 root "$REPO/scripts/ops/verify-restore.sh" >> /var/log/kiwiply-restore-drill.log 2>&1

# Daily: archive the uploads volume (resumes, attachments, built PDFs) and ship it off the box.
# After the database dump so the two sit close in time. Needs HC_UPLOADS_URL in .env (DEPLOY.md §5.7).
40 3 * * * root "$REPO/scripts/ops/backup-uploads.sh" >> /var/log/kiwiply-backup-uploads.log 2>&1

# Every 5 minutes: disk, memory, container restarts and certificate expiry on the box. Silent when
# all is well; pings Healthchecks.io "host" (HC_HOST_URL in .env), with the reasons on a failure.
*/5 * * * * root "$REPO/scripts/ops/host-guard.sh" >> /var/log/kiwiply-host-guard.log 2>&1

# Every 15 minutes: rotate the MySQL binary log and copy every closed file off the box (point-in-time
# recovery between the nightly dumps; RPO about 15 minutes). A no-op until BACKUP_S3_BUCKET and the
# backup keys are in .env; pings Healthchecks.io "binlog" (HC_BINLOG_URL, period 15 min). DEPLOY.md §5.9.
*/15 * * * * root "$REPO/scripts/ops/ship-binlogs.sh" >> /var/log/kiwiply-binlog.log 2>&1

# Monthly, the 1st at 05:30 UTC: restore the newest dump AND replay the binlogs written after it into a
# throwaway container, sanity-check, report (HC_DRILL_URL, period 31 days). Never touches the live DB.
# The weekly Sunday check above only proves the dump restores; this proves point-in-time recovery too.
30 5 1 * * root "$REPO/scripts/ops/restore-drill.sh" >> /var/log/kiwiply-restore-drill-monthly.log 2>&1
