# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must keep LF even on Windows checkouts - they are scp'd to Linux hosts,
# and CRLF makes the shebang fail with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# ResumeDocument golden fixtures are compared byte for byte (Java + TS); never CRLF.
api/src/test/resources/resume-doc/** text eol=lf
# The @kiwiply/ui copies of those fixtures (R0.4) - same byte-for-byte rule.
packages/ui/src/resume/__fixtures__/** text eol=lf

# Vitest snapshots are written with LF; pin them so Windows checkouts stop showing line-ending-only diffs.
**/__snapshots__/*.snap text eol=lf
