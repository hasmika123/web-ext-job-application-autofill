exports[`Modern template > full: HTML snapshot 1`] = `"<div class="rz-root" data-rz-theme="tn29k6" data-rz-template="modern"><style>[data-rz-theme="tn29k6"]{--rz-accent:#111827;--rz-font-body:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-font-display:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-size:11pt;--rz-density:1;--rz-margin:0.75in;--rz-page-w:8.5in;--rz-page-h:11in}@page{size:8.5in 11in;margin:0.75in}</style><div class="rz-page rz-tpl-modern"><header class="rz-header"><h1 class="rz-name">Priya Sharma</h1><p class="rz-headline">Software Engineer</p><span class="rz-contact"><a class="rz-link" href="mailto:priya@example.com">priya@example.com</a><span class="rz-sep"> | </span>+1 415 555 0100<span class="rz-sep"> | </span>San Francisco, CA<span class="rz-sep"> | </span><a class="rz-link" href="https://linkedin.com/in/priya">LinkedIn</a><span class="rz-sep"> | </span><a class="rz-link" href="https://github.com/priya">github.com/priya</a></span></header><main class="rz-main"><section class="rz-section rz-section-summary"><h2 class="rz-section-title">Summary</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-text">Results-driven backend engineer with 6 years of experience building payment systems.</p></div></div></section><section class="rz-section rz-section-experience"><h2 class="rz-section-title">Experience</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Software Engineer</span><span class="rz-sep"> — </span><span class="rz-item-org">Google</span></span></div><div class="rz-item-dates">Jun 2022 – Present</div></div><div class="rz-item-sub">Mountain View, CA</div><ul class="rz-bullets"><li class="rz-bullet">Led migration of the billing service to Kubernetes, cutting p99 latency by 40%.</li><li class="rz-bullet">Built an internal tool used by 300 engineers.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Backend Developer</span><span class="rz-sep"> — </span><span class="rz-item-org">Acme Corp</span></span></div><div class="rz-item-dates">2019 – May 2022</div></div><div class="rz-item-sub">Zürich, Switzerland</div><ul class="rz-bullets"><li class="rz-bullet">Designed a ledger service handling 2M transactions a day.</li><li class="rz-bullet">Mentored three junior engineers – two were promoted.</li></ul></div></div></div></section><section class="rz-section rz-section-education"><h2 class="rz-section-title">Education</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">B.S. in Computer Science</span><span class="rz-sep"> — </span><span class="rz-item-org">Stanford University</span></span></div><div class="rz-item-dates">Sep 2014 – Jun 2018</div></div><div class="rz-item-sub">Stanford, CA · GPA: 3.8</div><ul class="rz-bullets"><li class="rz-bullet">Dean&#x27;s List, six quarters.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">M.S.</span><span class="rz-sep"> — </span><span class="rz-item-org">MIT</span></span></div><div class="rz-item-dates">2020</div></div></div></div></div></section><section class="rz-section rz-section-skills"><h2 class="rz-section-title">Skills</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Languages: </span><span class="rz-skill-list">Java, Go, Python</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Cloud: </span><span class="rz-skill-list">AWS, Kubernetes</span></p></div></div></section><section class="rz-section rz-section-projects"><h2 class="rz-section-title">Projects</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Open-source CLI</span><span class="rz-sep"> · </span><a class="rz-link" href="https://github.com/priya/cli">github.com/priya/cli</a></span></div></div><ul class="rz-bullets"><li class="rz-bullet">Reached 2k GitHub stars.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Side project</span></span></div></div></div></div></div></section><section class="rz-section rz-section-languages"><h2 class="rz-section-title">Languages</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-line"><span><span class="rz-item-title">English</span><span class="rz-sep"> — </span>Native</span></p></div><div class="rz-entry"><p class="rz-line"><span><span class="rz-item-title">Spanish</span><span class="rz-sep"> — </span>Professional</span></p></div><div class="rz-entry"><p class="rz-line"><span><span class="rz-item-title">French</span></span></p></div></div></section><section class="rz-section rz-section-achievements"><h2 class="rz-section-title">Achievements</h2><div class="rz-section-body"><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Won the 2023 company hackathon.<span class="rz-sep"> · </span>2023</span></li></ul></div><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Speaker at GopherCon.</span></li></ul></div></div></section><section class="rz-section rz-section-custom"><h2 class="rz-section-title">Volunteering</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Mentor</span><span class="rz-sep"> — </span><span class="rz-item-org">Code.org</span></span></div><div class="rz-item-dates">Jan 2020</div></div><ul class="rz-bullets"><li class="rz-bullet">Weekly coaching sessions for first-time programmers.</li></ul></div></div></div></section></main></div></div>"`;

