exports[`compact template > compact: HTML snapshot (caps-doc) 1`] = `
"<div class="rz-root" data-rz-theme="1asjcwr" data-rz-template="compact"><style>[data-rz-theme="1asjcwr"]{--rz-accent:#111827;--rz-font-body:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-font-display:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-size:10.5pt;--rz-density:0.88;--rz-margin:0.6in;--rz-page-w:8.5in;--rz-page-h:11in}@page{size:8.5in 11in;margin:0.6in}</style><div class="rz-page rz-tpl-compact"><header class="rz-header"><h1 class="rz-name">Casey Rivera</h1><p class="rz-headline">Product Manager</p><span class="rz-contact"><a class="rz-link" href="mailto:casey@example.com">casey@example.com</a><span class="rz-sep"> | </span>+1 202 555 0143<span class="rz-sep"> | </span>Austin, TX<span class="rz-sep"> | </span><a class="rz-link" href="https://casey.example.com">Portfolio</a></span></header><main class="rz-main"><section class="rz-section rz-section-summary"><h2 class="rz-section-title">Summary</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-text"><strong>Product leader</strong> who ships.
Obsessed with clarity.</p></div></div></section><section class="rz-section rz-section-experience"><h2 class="rz-section-title">Experience</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Group Product Manager</span><span class="rz-sep"> — </span><span class="rz-item-org">Northwind</span></span></div><div class="rz-item-dates">Mar 2020 – Present</div></div><div class="rz-item-sub">Remote</div><ul class="rz-bullets"><li class="rz-bullet">Grew revenue 3x after launching the self-serve plan (details in the case study).</li><li class="rz-bullet">Built and led a team of eight product managers.</li></ul></div></div></div></section><section class="rz-section rz-section-skills"><h2 class="rz-section-title">Skills</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Languages: </span><span class="rz-skill-list">Languages one, Languages two</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Cloud: </span><span class="rz-skill-list">Cloud one, Cloud two</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Data: </span><span class="rz-skill-list">Data one, Data two</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Tools: </span><span class="rz-skill-list">Tools one, Tools two</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Practices: </span><span class="rz-skill-list">Practices one, Practices two</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Methods: </span><span class="rz-skill-list">Methods one, Methods two, Leadership one, Leadership two, Domains one, Domains two</span></p></div></div></section><section class="rz-section rz-section-custom"><h2 class="rz-section-title">Volunteering &amp; Impact!</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Mentor</span><span class="rz-sep"> — </span><span class="rz-item-org">Code.org</span></span></div></div><ul class="rz-bullets"><li class="rz-bullet">Coached first-time programmers.</li></ul></div></div></div></section></main></div></div>"
`;

exports[`compact template > compact: HTML snapshot (full-v2) 1`] = `
"<div class="rz-root" data-rz-theme="1asjcwr" data-rz-template="compact"><style>[data-rz-theme="1asjcwr"]{--rz-accent:#111827;--rz-font-body:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-font-display:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-size:10.5pt;--rz-density:0.88;--rz-margin:0.6in;--rz-page-w:8.5in;--rz-page-h:11in}@page{size:8.5in 11in;margin:0.6in}</style><div class="rz-page rz-tpl-compact"><header class="rz-header"><h1 class="rz-name">Priya Sharma</h1><p class="rz-headline">Software Engineer</p><span class="rz-contact"><a class="rz-link" href="mailto:priya@example.com">priya@example.com</a><span class="rz-sep"> | </span>+1 415 555 0100<span class="rz-sep"> | </span>San Francisco, CA<span class="rz-sep"> | </span><a class="rz-link" href="https://linkedin.com/in/priya">LinkedIn</a><span class="rz-sep"> | </span><a class="rz-link" href="https://github.com/priya">github.com/priya</a></span></header><main class="rz-main"><section class="rz-section rz-section-summary"><h2 class="rz-section-title">Summary</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-text">Results-driven <strong>backend engineer</strong> with 6 years of experience.
Built payment systems used by 2M people.
Loves clean APIs.</p></div></div></section><section class="rz-section rz-section-experience"><h2 class="rz-section-title">Experience</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Software Engineer</span><span class="rz-sep"> — </span><span class="rz-item-org">Google</span></span></div><div class="rz-item-dates">Jun 2022 – Present</div></div><div class="rz-item-sub">Mountain View, CA</div><ul class="rz-bullets"><li class="rz-bullet">Led migration of the billing service to Kubernetes, cutting <strong>p99 latency by 40%</strong>.</li><li class="rz-bullet">Built an internal tool used by 300 engineers.</li><li class="rz-bullet">Wrote the runbook (and the postmortem template) the whole team now uses.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Backend Developer</span><span class="rz-sep"> — </span><span class="rz-item-org">Acme Corp</span></span></div><div class="rz-item-dates">2019 – May 2022</div></div><div class="rz-item-sub">Zürich, Switzerland</div><ul class="rz-bullets"><li class="rz-bullet">Designed a ledger service handling <strong>2M</strong> transactions a day.</li><li class="rz-bullet">Mentored three junior engineers – two were promoted.</li></ul></div></div></div></section><section class="rz-section rz-section-education"><h2 class="rz-section-title">Education</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">B.S. in Computer Science</span><span class="rz-sep"> — </span><span class="rz-item-org">Stanford University</span></span></div><div class="rz-item-dates">Sep 2014 – Jun 2018</div></div><div class="rz-item-sub">Stanford, CA · GPA: 3.8</div><ul class="rz-bullets"><li class="rz-bullet">Dean&#x27;s List, six quarters.</li></ul></div></div></div></section><section class="rz-section rz-section-skills"><h2 class="rz-section-title">Skills</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Languages: </span><span class="rz-skill-list">Java, Go, Python</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Cloud: </span><span class="rz-skill-list">AWS, Kubernetes</span></p></div></div></section><section class="rz-section rz-section-projects"><h2 class="rz-section-title">Projects</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Open-source CLI</span><span class="rz-sep"> · </span><a class="rz-link" href="https://github.com/priya/cli">github.com/priya/cli</a></span></div><div class="rz-item-dates">Feb 2021 – 2022</div></div><ul class="rz-bullets"><li class="rz-bullet">Reached <strong>2k</strong> GitHub stars.</li></ul></div></div></div></section><section class="rz-section rz-section-achievements"><h2 class="rz-section-title">Achievements</h2><div class="rz-section-body"><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Won the <strong>2023</strong> company hackathon.<span class="rz-sep"> · </span>2023</span></li></ul></div><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Speaker at GopherCon.</span></li></ul></div></div></section><section class="rz-section rz-section-custom"><h2 class="rz-section-title">Volunteering</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Mentor</span><span class="rz-sep"> — </span><span class="rz-item-org">Code.org</span></span></div><div class="rz-item-dates">Jan 2020</div></div><ul class="rz-bullets"><li class="rz-bullet">Weekly coaching sessions for first-time programmers.</li></ul></div></div></div></section></main></div></div>"
`;

exports[`compact template > compact: HTML snapshot (sample) 1`] = `"<div class="rz-root" data-rz-theme="1asjcwr" data-rz-template="compact"><style>[data-rz-theme="1asjcwr"]{--rz-accent:#111827;--rz-font-body:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-font-display:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-size:10.5pt;--rz-density:0.88;--rz-margin:0.6in;--rz-page-w:8.5in;--rz-page-h:11in}@page{size:8.5in 11in;margin:0.6in}</style><div class="rz-page rz-tpl-compact"><header class="rz-header"><h1 class="rz-name">Jordan Avery</h1><p class="rz-headline">Senior Software Engineer</p><span class="rz-contact"><a class="rz-link" href="mailto:jordan.avery@example.com">jordan.avery@example.com</a><span class="rz-sep"> | </span>+1 (555) 010-0123<span class="rz-sep"> | </span>Austin, TX<span class="rz-sep"> | </span><a class="rz-link" href="https://www.linkedin.com/in/jordan-avery-example">LinkedIn</a><span class="rz-sep"> | </span><a class="rz-link" href="https://github.com/jordan-avery-example">GitHub</a><span class="rz-sep"> | </span><a class="rz-link" href="https://jordanavery.example.com">Portfolio</a></span></header><main class="rz-main"><section class="rz-section rz-section-summary"><h2 class="rz-section-title">Summary</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-text">Senior software engineer with <strong>8 years</strong> building distributed systems for logistics and healthcare. Led teams of up to 6 engineers and cut infrastructure spend by 31% while raising uptime to 99.95%. Comfortable owning a service from design review to on-call.</p></div></div></section><section class="rz-section rz-section-experience"><h2 class="rz-section-title">Experience</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Senior Software Engineer</span><span class="rz-sep"> — </span><span class="rz-item-org">Harbor &amp; Vale Logistics</span></span></div><div class="rz-item-dates">Mar 2022 – Present</div></div><div class="rz-item-sub">Austin, TX</div><ul class="rz-bullets"><li class="rz-bullet">Cut p99 checkout latency from 1.8 s to 420 ms for 2.4M monthly shipments by moving rate calculation to an event-driven service with a Redis read model.</li><li class="rz-bullet">Reduced cloud spend by 31% ($410k a year) by right-sizing 140 Kubernetes workloads and moving batch jobs to spot capacity with checkpointed retries.</li><li class="rz-bullet">Led a team of 6 engineers through the migration of 38 services off a shared monolith with zero customer-facing incidents over 14 months.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Software Engineer</span><span class="rz-sep"> — </span><span class="rz-item-org">Lumen Grove Health</span></span></div><div class="rz-item-dates">Jun 2019 – Feb 2022</div></div><div class="rz-item-sub">Remote</div><ul class="rz-bullets"><li class="rz-bullet">Raised appointment-reminder delivery from 91% to 99.6% across 300k patients a month by rebuilding the SMS pipeline with idempotent retries and carrier failover.</li><li class="rz-bullet">Shortened release cycle from two weeks to daily by introducing trunk-based development, contract tests and a canary stage used by 40 engineers.</li><li class="rz-bullet">Passed a SOC 2 Type II audit with no findings by designing the audit-log service (Go, Postgres) and its retention policy.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Software Engineer I</span><span class="rz-sep"> — </span><span class="rz-item-org">Pinecrest Analytics</span></span></div><div class="rz-item-dates">Jul 2017 – May 2019</div></div><div class="rz-item-sub">Denver, CO</div><ul class="rz-bullets"><li class="rz-bullet">Doubled dashboard query throughput (1.1k to 2.3k queries a minute) by adding a columnar cache layer in front of the warehouse.</li><li class="rz-bullet">Wrote the Python SDK used by 60 customer integrations, with 94% test coverage and typed public APIs.</li><li class="rz-bullet">Ran the weekly on-call handover and cut mean time to acknowledge from 22 to 6 minutes with clearer runbooks.</li></ul></div></div></div></section><section class="rz-section rz-section-education"><h2 class="rz-section-title">Education</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">M.S. in Computer Science</span><span class="rz-sep"> — </span><span class="rz-item-org">University of Westbrook</span></span></div><div class="rz-item-dates">Aug 2015 – May 2017</div></div><div class="rz-item-sub">Westbrook, OR · GPA: 3.8</div><ul class="rz-bullets"><li class="rz-bullet">Thesis: adaptive load shedding for latency-sensitive microservices.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">B.S. in Computer Science</span><span class="rz-sep"> — </span><span class="rz-item-org">Cedar State University</span></span></div><div class="rz-item-dates">Aug 2011 – May 2015</div></div><div class="rz-item-sub">Pinecrest, CO</div></div></div></div></section><section class="rz-section rz-section-skills"><h2 class="rz-section-title">Skills</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Languages: </span><span class="rz-skill-list">Go, TypeScript, Python, Java, SQL</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Frameworks: </span><span class="rz-skill-list">React, Node.js, Spring Boot, gRPC</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Cloud &amp; Infrastructure: </span><span class="rz-skill-list">AWS, Kubernetes, Terraform, Docker, GitHub Actions</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Data: </span><span class="rz-skill-list">PostgreSQL, Redis, Kafka, BigQuery</span></p></div><div class="rz-entry"><p class="rz-skill-row"><span class="rz-skill-group">Practices: </span><span class="rz-skill-list">Incident response, Observability, Technical leadership, Mentoring</span></p></div></div></section><section class="rz-section rz-section-projects"><h2 class="rz-section-title">Projects</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Surge</span><span class="rz-sep"> · </span><a class="rz-link" href="https://github.com/jordan-avery-example/surge">github.com/jordan-avery-example/surge</a></span></div><div class="rz-item-dates">Feb 2023 – Jan 2024</div></div><ul class="rz-bullets"><li class="rz-bullet">Published Surge, a load-testing harness with 1.2k GitHub stars; adopted by 40+ engineers at three companies.</li><li class="rz-bullet">Generates realistic traffic shapes from production traces and reports p50/p99 regressions in CI.</li></ul></div></div><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Ledgerline</span><span class="rz-sep"> · </span><a class="rz-link" href="https://jordanavery.example.com/ledgerline">jordanavery.example.com/ledgerline</a></span></div><div class="rz-item-dates">2021 – 2021</div></div><ul class="rz-bullets"><li class="rz-bullet">Open-source double-entry ledger library (Go) with exactly-once posting; 300 downloads a week.</li></ul></div></div></div></section><section class="rz-section rz-section-certifications"><h2 class="rz-section-title">Certifications</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item rz-item-tight"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Certified Cloud Architect</span><span class="rz-sep"> — </span><span class="rz-item-org">Open Cloud Council</span></span></div><div class="rz-item-dates">Apr 2023</div></div><div class="rz-item-sub"><a class="rz-link" href="https://certs.example.com/occ/jordan-avery">certs.example.com/occ/jordan-avery</a></div></div></div><div class="rz-entry"><div class="rz-item rz-item-tight"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Professional Scrum Master I</span><span class="rz-sep"> — </span><span class="rz-item-org">Agile Guild</span></span></div><div class="rz-item-dates">Nov 2020</div></div></div></div></div></section><section class="rz-section rz-section-languages"><h2 class="rz-section-title">Languages</h2><div class="rz-section-body"><div class="rz-entry"><p class="rz-line"><span><span class="rz-item-title">English</span><span class="rz-sep"> — </span>Native</span></p></div><div class="rz-entry"><p class="rz-line"><span><span class="rz-item-title">Spanish</span><span class="rz-sep"> — </span>Professional working proficiency</span></p></div></div></section><section class="rz-section rz-section-achievements"><h2 class="rz-section-title">Achievements</h2><div class="rz-section-body"><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Engineering Excellence Award, Harbor &amp; Vale Logistics (1 of 4 across 220 engineers).<span class="rz-sep"> · </span>2024</span></li></ul></div><div class="rz-entry"><ul class="rz-bullets"><li class="rz-bullet"><span>Speaker, Reliability Summit: &quot;Load shedding without losing customers&quot;.<span class="rz-sep"> · </span>Sep 2023</span></li></ul></div></div></section><section class="rz-section rz-section-custom"><h2 class="rz-section-title">Volunteering</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Mentor</span><span class="rz-sep"> — </span><span class="rz-item-org">Code Bridge Austin</span></span></div><div class="rz-item-dates">Jan 2020 – Present</div></div><div class="rz-item-sub">Austin, TX</div><ul class="rz-bullets"><li class="rz-bullet">Coached 25 career-changers through their first backend projects; 18 are now employed as engineers.</li></ul></div></div></div></section></main></div></div>"`;

exports[`compact template > compact: HTML snapshot (sparse) 1`] = `"<div class="rz-root" data-rz-theme="1asjcwr" data-rz-template="compact"><style>[data-rz-theme="1asjcwr"]{--rz-accent:#111827;--rz-font-body:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-font-display:"Inter", "Helvetica Neue", Arial, sans-serif;--rz-size:10.5pt;--rz-density:0.88;--rz-margin:0.6in;--rz-page-w:8.5in;--rz-page-h:11in}@page{size:8.5in 11in;margin:0.6in}</style><div class="rz-page rz-tpl-compact"><header class="rz-header"><h1 class="rz-name">Sam Lee</h1></header><main class="rz-main"><section class="rz-section rz-section-experience"><h2 class="rz-section-title">Experience</h2><div class="rz-section-body"><div class="rz-entry"><div class="rz-item"><div class="rz-item-head"><div class="rz-item-main"><span><span class="rz-item-title">Barista</span><span class="rz-sep"> — </span><span class="rz-item-org">Blue Door Cafe</span></span></div><div class="rz-item-dates">2021</div></div></div></div></div></section></main></div></div>"`;
