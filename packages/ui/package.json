{
  "name": "@kiwiply/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI for the Kiwiply web app and browser extension: design tokens + React primitives + the portable ResumeUpload form. Consumed AS SOURCE by both Next (web, via transpilePackages) and Vite/WXT (extension) — no build step. React is a peer (the consumer provides it).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/animations.css": "./styles/animations.css",
    "./styles/theme-v2.css": "./styles/theme-v2.css",
    "./styles/resume.css": "./styles/resume.css",
    "./styles/resume-print.css": "./styles/resume-print.css",
    "./fonts/*": "./fonts/*",
    "./resume/thumbs/*": "./src/resume/thumbs/*"
  },
  "files": [
    "src",
    "styles",
    "fonts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^28.1.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
