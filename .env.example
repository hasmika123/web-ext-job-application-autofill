# Production environment for docker-compose.prod.yml.
# Copy to ".env" ON THE SERVER and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env   &&   nano .env
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Root password for the MySQL container (used by the API too). Pick something long.
MYSQL_ROOT_PASSWORD=change-me-long-random

# ---------------------------------------------------------------------------
# Auth — JWT signing secret (REQUIRED; the API refuses to start without it)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 64
JWT_BASE64_SECRET=

# ---------------------------------------------------------------------------
# Object storage — AWS S3 (private bucket)
# ---------------------------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET=dossier-resumes
# IAM user with least privilege on the bucket only (Get/Put/DeleteObject).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# TLS / hostnames (sslip.io — real HTTPS on a bare IP, no domain needed)
# ---------------------------------------------------------------------------
# Dashed form of your server's PUBLIC IP. Example: IP 203.0.113.5 -> 203-0-113-5.sslip.io
# The app is then at  https://app.<SSLIP_HOST>  and the API at  https://api.<SSLIP_HOST>.
SSLIP_HOST=CHANGE-ME.sslip.io
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# CORS — for the browser extension's direct API calls
# ---------------------------------------------------------------------------
# Pre-launch the unpacked extension has an unstable id, so a wildcard is fine. At launch,
# pin it: CORS_ALLOWED_ORIGIN_PATTERNS=chrome-extension://<published-id>
CORS_ALLOWED_ORIGIN_PATTERNS=chrome-extension://*

# ---------------------------------------------------------------------------
# Email verification (Brevo SMTP) — required before public signups
# ---------------------------------------------------------------------------
# Brevo → SMTP & API → SMTP. Leave MAIL_HOST blank to disable email (signups then need
# manual activation). See DEPLOY.md §9.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=        # Brevo SMTP login, e.g. 8a1b2c001@smtp-brevo.com
MAIL_PASSWORD=        # Brevo SMTP key (NOT your Brevo account password)
MAIL_FROM=            # your Brevo-VERIFIED sender address, e.g. you@gmail.com
# MAIL_BASE_URL defaults to https://<SSLIP_HOST> (the canonical app host); override only if
# the app lives somewhere else. # MAIL_BASE_URL=https://example.com
