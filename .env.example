# Production environment for docker-compose.prod.yml.
# Copy to ".env" ON THE SERVER and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env   &&   nano .env
#
# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Root password for the MySQL container (used by the API too). Pick something long.
MYSQL_ROOT_PASSWORD=change-me-long-random

# ---------------------------------------------------------------------------
# Auth — JWT signing secret (REQUIRED; the API refuses to start without it)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 64
JWT_BASE64_SECRET=

# ---------------------------------------------------------------------------
# Admin bootstrap (Phase 9.A0) — the real production admin account
# ---------------------------------------------------------------------------
# The default admin/admin seed NO LONGER exists in prod. Set these to install a real admin at
# startup (created on first boot, password rotated on later boots if you change the hash).
# ADMIN_PASSWORD_HASH is a BCRYPT hash, never a plaintext password — it stays in env only.
# Generate one (no plaintext on disk):  htpasswd -bnBC 10 "" 'your-strong-password' | tr -d ':\n'
# ⚠️ DOUBLE every '$' to '$$' here — Docker Compose interpolates '$' in .env, which corrupts the
#    hash otherwise (it would arrive as "$y$10$..." and be rejected). So $2y$10$abc → $$2y$$10$$abc.
#    See DEPLOY.md §2.1 for a one-liner that prints the correctly-escaped value.
# Leave both blank to skip the bootstrap (then no admin can sign in).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# ADMIN_LOGIN defaults to "admin"; override only if you want a different admin username.
# ADMIN_LOGIN=admin
# Email-OTP MFA for admin sign-in (Phase 9.X.3). OFF by default. Set to true ONLY after confirming
# admin email delivery works (Brevo) — the one-time code is emailed. To recover if misconfigured,
# set back to false and recreate the api container. (An admin with no email is not challenged.)
# ADMIN_MFA_ENABLED=false

# ---------------------------------------------------------------------------
# Object storage — AWS S3 (private bucket)
# ---------------------------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET=dossier-resumes
# IAM user with least privilege on the bucket only (Get/Put/DeleteObject).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Base host (TLS hostnames) — your domain, or a sslip.io host if you have no domain
# ---------------------------------------------------------------------------
# Prod uses the real domain: SSLIP_HOST=kiwiply.com  → app at https://kiwiply.com (apex
# canonical; www/app 301 to it), API at https://api.kiwiply.com. Point DNS A records for
# the apex + www + api at the server IP.
# No domain? Use the dashed-IP sslip.io form instead: IP 203.0.113.5 -> 203-0-113-5.sslip.io
# (the var name is historical; it just holds the base host). Caddy gets Let's Encrypt certs.
SSLIP_HOST=kiwiply.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# CORS — for the browser extension's direct API calls
# ---------------------------------------------------------------------------
# Pre-launch the unpacked extension has an unstable id, so a wildcard is fine. At launch,
# pin it: CORS_ALLOWED_ORIGIN_PATTERNS=chrome-extension://<published-id>
CORS_ALLOWED_ORIGIN_PATTERNS=chrome-extension://*

# ---------------------------------------------------------------------------
# Email verification (Brevo SMTP) — required before public signups
# ---------------------------------------------------------------------------
# Brevo → SMTP & API → SMTP. Leave MAIL_HOST blank to disable email (signups then need
# manual activation). See DEPLOY.md §9.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=        # Brevo SMTP login, e.g. 8a1b2c001@smtp-brevo.com
MAIL_PASSWORD=        # Brevo SMTP key (NOT your Brevo account password)
MAIL_FROM=            # your Brevo-VERIFIED sender address, e.g. you@gmail.com

# --- Newsletter: Brevo list sync + postal address (Phase 9.A4.4) -----------------------
# Mirror confirmed subscribers to a Brevo contact list (the local DB stays the source of truth).
# OFF unless BOTH are set. BREVO_API_KEY = a Brevo API v3 key (Brevo → SMTP & API → API Keys);
# BREVO_LIST_ID = the numeric id of the target Brevo contact list.
BREVO_API_KEY=
BREVO_LIST_ID=0
# Physical postal address shown in marketing-email footers (CAN-SPAM). Set before sending campaigns.
NEWSLETTER_POSTAL_ADDRESS=
# MAIL_BASE_URL defaults to https://<SSLIP_HOST> (the canonical app host); override only if
# the app lives somewhere else. # MAIL_BASE_URL=https://example.com

# --- Server-side AI drafting (Phase 5.1) -------------------------------------------------
# OFF unless DOSSIER_AI_ENABLED=true AND an API key is set. The key lives here only — it is
# NEVER shipped in the extension. Provider-agnostic: swap provider/model without code changes.
# Default is Google Gemini's FREE tier — note Google may use inputs to improve its services, so
# the extension keeps AI drafting OPT-IN and the privacy policy discloses it. Use a paid key (or
# another provider) to remove that data-use caveat. Get a key: https://aistudio.google.com/apikey
DOSSIER_AI_ENABLED=false
DOSSIER_AI_PROVIDER=gemini
DOSSIER_AI_MODEL=gemini-2.5-flash-lite
DOSSIER_AI_API_KEY=          # Google AI Studio key (free tier); leave blank to keep AI off
DOSSIER_AI_FREE_MONTHLY_QUOTA=50
# Output cap for structured resume parsing (POST /api/ai/parse-resume — same key/quota;
# one parse = one AI credit). Full-resume JSON needs far more room than a short draft.
DOSSIER_AI_PARSE_MAX_OUTPUT_TOKENS=4000

# --- "Sign in with Google" ---------------------------------------------------------------
# The OAuth 2.0 Web client id (Google Cloud Console -> Credentials). NOT a secret — it also
# ships in the web bundle. The compose file already defaults to the current id, so set this
# only to OVERRIDE it. The API requires it as the ID-token audience (empty => 503). The web
# button reads NEXT_PUBLIC_GOOGLE_CLIENT_ID at BUILD time and otherwise defaults in code.
# GOOGLE_CLIENT_ID=482405713424-qtq3seoa0d8bg0e26f2bpisnqvjgt15o.apps.googleusercontent.com
