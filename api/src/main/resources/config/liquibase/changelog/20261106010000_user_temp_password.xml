<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Enterprise V2, X1.11 (owner onboarding) and the employee direct-create story: an account made by a platform or organization
        administrator starts with a server-generated TEMPORARY password. While password_change_required is true the person can sign in
        but the session may only change the password (and read its own account, refresh, log out). The temporary password stops working
        at password_temp_expires_at. Both are cleared when the person sets their own password. Only the admin-created-account paths
        ever set them; everybody else keeps false / null. Additive only.
    -->
    <changeSet id="user-temp-password-1" author="enterprise" runInTransaction="false">
        <preConditions onFail="MARK_RAN"><not><columnExists tableName="jhi_user" columnName="password_change_required"/></not></preConditions>
        <addColumn tableName="jhi_user">
            <column name="password_change_required" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="password_temp_expires_at" type="${datetimeType}"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
