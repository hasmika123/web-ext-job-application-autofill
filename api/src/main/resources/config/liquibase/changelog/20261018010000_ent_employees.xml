<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Enterprise V2 X4.3 / X4.4 - employees (docs/enterprise-v2/41-database-design.md changelog 4 "ent_employees",
        15-employees-and-teams.md sections 2, 3, 5).

        Additive only. org_member gains the org-set title, the department and team the person sits in, the reporting manager and the
        throttled "last active" time (all nullable: every existing row keeps today's behaviour; the Employees board falls back to the
        legacy single group_id when the new links are empty). org_group gains parent_group_id so a team can belong to a department
        (X4.5 owns the group editor; the members API only needs the link to enforce "team inside department" and DEPARTMENT scope).
        Two new tables: org_member_offboarding (a scheduled last day; one PENDING row per member, a database fact) and
        idempotency_record (the 24 h ledger of Idempotency-Key replies, 40-api-specs.md section 6).

        Every changeSet has a precondition (MARK_RAN) and a rollback. No DATE OF BIRTH, no government id, no bank number anywhere.
    -->

    <changeSet id="20261018010000-1" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="org_member" columnName="title"/></not>
        </preConditions>
        <addColumn tableName="org_member">
            <column name="title" type="varchar(120)"/>
        </addColumn>
        <rollback><dropColumn tableName="org_member" columnName="title"/></rollback>
    </changeSet>

    <changeSet id="20261018010000-2" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="org_member" columnName="department_group_id"/></not>
        </preConditions>
        <addColumn tableName="org_member">
            <column name="department_group_id" type="bigint"/>
            <column name="team_group_id" type="bigint"/>
            <column name="manager_member_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="org_member" baseColumnNames="department_group_id"
            constraintName="fk_member_department" referencedTableName="org_group" referencedColumnNames="id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="org_member" baseColumnNames="team_group_id"
            constraintName="fk_member_team" referencedTableName="org_group" referencedColumnNames="id" onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="org_member" baseColumnNames="manager_member_id"
            constraintName="fk_member_manager" referencedTableName="org_member" referencedColumnNames="id" onDelete="SET NULL"/>
        <createIndex tableName="org_member" indexName="ix_member_org_department">
            <column name="org_id"/>
            <column name="status"/>
            <column name="department_group_id"/>
        </createIndex>
        <createIndex tableName="org_member" indexName="ix_member_org_team">
            <column name="org_id"/>
            <column name="team_group_id"/>
        </createIndex>
        <createIndex tableName="org_member" indexName="ix_member_org_manager">
            <column name="org_id"/>
            <column name="manager_member_id"/>
        </createIndex>
        <rollback>
            <dropForeignKeyConstraint baseTableName="org_member" constraintName="fk_member_manager"/>
            <dropForeignKeyConstraint baseTableName="org_member" constraintName="fk_member_team"/>
            <dropForeignKeyConstraint baseTableName="org_member" constraintName="fk_member_department"/>
            <dropIndex tableName="org_member" indexName="ix_member_org_manager"/>
            <dropIndex tableName="org_member" indexName="ix_member_org_team"/>
            <dropIndex tableName="org_member" indexName="ix_member_org_department"/>
            <dropColumn tableName="org_member" columnName="manager_member_id"/>
            <dropColumn tableName="org_member" columnName="team_group_id"/>
            <dropColumn tableName="org_member" columnName="department_group_id"/>
        </rollback>
    </changeSet>

    <changeSet id="20261018010000-3" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="org_member" columnName="last_active_at"/></not>
        </preConditions>
        <addColumn tableName="org_member">
            <column name="last_active_at" type="${datetimeType}"/>
        </addColumn>
        <createIndex tableName="org_member" indexName="ix_member_org_last_active">
            <column name="org_id"/>
            <column name="last_active_at"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="org_member" indexName="ix_member_org_last_active"/>
            <dropColumn tableName="org_member" columnName="last_active_at"/>
        </rollback>
    </changeSet>

    <changeSet id="20261018010000-4" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="org_group" columnName="parent_group_id"/></not>
        </preConditions>
        <addColumn tableName="org_group">
            <column name="parent_group_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="org_group" baseColumnNames="parent_group_id"
            constraintName="fk_org_group_parent" referencedTableName="org_group" referencedColumnNames="id" onDelete="SET NULL"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="org_group" constraintName="fk_org_group_parent"/>
            <dropColumn tableName="org_group" columnName="parent_group_id"/>
        </rollback>
    </changeSet>

    <!-- A scheduled last day: the seat stays ACTIVE until effective_at, then the offboarding job applies it. -->
    <changeSet id="20261018010000-5" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="org_member_offboarding"/></not>
        </preConditions>
        <createTable tableName="org_member_offboarding">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="org_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="effective_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_member_id" type="bigint"/>
            <column name="status" type="varchar(12)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="outcome" type="varchar(200)"/>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="done_at" type="${datetimeType}"/>
        </createTable>
        <createIndex tableName="org_member_offboarding" indexName="ix_member_offboarding_due">
            <column name="org_id"/>
            <column name="status"/>
            <column name="effective_at"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="org_member_offboarding" baseColumnNames="org_id"
            constraintName="fk_member_offboarding_org" referencedTableName="organization" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="org_member_offboarding" baseColumnNames="member_id"
            constraintName="fk_member_offboarding_member" referencedTableName="org_member" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="org_member_offboarding" baseColumnNames="created_by_member_id"
            constraintName="fk_member_offboarding_creator" referencedTableName="org_member" referencedColumnNames="id" onDelete="SET NULL"/>
        <rollback>
            <dropTable tableName="org_member_offboarding"/>
        </rollback>
    </changeSet>

    <changeSet id="20261018010000-6" author="dossier" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="org_member_offboarding" columnName="pending_key"/></not>
        </preConditions>
        <sql>
            ALTER TABLE org_member_offboarding ADD COLUMN pending_key BIGINT
                GENERATED ALWAYS AS (IF(status = 'PENDING', member_id, NULL)) STORED
        </sql>
        <rollback>
            <dropColumn tableName="org_member_offboarding" columnName="pending_key"/>
        </rollback>
    </changeSet>

    <changeSet id="20261018010000-7" author="dossier" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="org_member_offboarding" indexName="uk_member_offboarding_pending"/></not>
        </preConditions>
        <createIndex tableName="org_member_offboarding" indexName="uk_member_offboarding_pending" unique="true">
            <column name="pending_key"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="org_member_offboarding" indexName="uk_member_offboarding_pending"/>
        </rollback>
    </changeSet>

    <!-- The Idempotency-Key ledger (40-api-specs.md section 6): one reply per (actor, key); purged after 24 h. -->
    <changeSet id="20261018010000-8" author="dossier">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="idempotency_record"/></not>
        </preConditions>
        <createTable tableName="idempotency_record">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="org_id" type="bigint"/>
            <column name="actor_login" type="varchar(254)">
                <constraints nullable="false"/>
            </column>
            <column name="key_hash" type="char(64)">
                <constraints nullable="false"/>
            </column>
            <column name="request_hash" type="char(64)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="response_json" type="text"/>
            <column name="state" type="varchar(12)" defaultValue="DONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="idempotency_record" columnNames="actor_login, key_hash" constraintName="uk_idempotency_actor_key"/>
        <createIndex tableName="idempotency_record" indexName="ix_idempotency_expires">
            <column name="expires_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="idempotency_record"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
