<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 9.A2.2 — per-user AI monthly-quota override. One row per user (login) whose quota
        differs from the global default; no row = use the default. Admin-managed (audited).
    -->
    <changeSet id="20260629000100-1" author="dossier">
        <createTable tableName="ai_quota_override">
            <column name="login" type="varchar(50)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="monthly_quota" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
