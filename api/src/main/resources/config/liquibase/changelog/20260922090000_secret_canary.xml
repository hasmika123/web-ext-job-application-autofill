<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 14.2 - a known value encrypted with the inbox key, read back at every startup. If the
        box's DOSSIER_INBOX_KEY changes (a rebuilt .env, a typo), every stored app password becomes
        unreadable; this row makes that loud at boot instead of a silent failure on the next poll.
        `fingerprint` is the first 8 hex chars of the key's SHA-256 - enough to tell two keys apart,
        useless for recovering one. No user data. Additive.
    -->
    <changeSet id="20260922090000-1" author="dossier">
        <createTable tableName="secret_canary">
            <column name="name" type="varchar(40)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ciphertext" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="key_version" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="fingerprint" type="varchar(16)"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
