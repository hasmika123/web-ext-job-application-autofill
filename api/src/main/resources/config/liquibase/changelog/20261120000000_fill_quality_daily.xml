<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Issue 03: aggregate-only daily history for ATS regression detection. -->
    <changeSet id="20261120000000-1" author="dossier">
        <createTable tableName="fill_quality_daily">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="day" type="date"><constraints nullable="false"/></column>
            <column name="ats" type="varchar(40)"><constraints nullable="false"/></column>
            <column name="adapter" type="varchar(40)"><constraints nullable="false"/></column>
            <column name="ext_version" type="varchar(20)" defaultValue=""><constraints nullable="false"/></column>
            <column name="fills" type="bigint"><constraints nullable="false"/></column>
            <column name="fields_found" type="bigint"><constraints nullable="false"/></column>
            <column name="fields_filled" type="bigint"><constraints nullable="false"/></column>
            <column name="fills_with_required_gaps" type="bigint"><constraints nullable="false"/></column>
            <column name="fill_rate_bp" type="integer"><constraints nullable="false"/></column>
            <column name="gap_rate_bp" type="integer"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="fill_quality_daily" columnNames="day, ats, adapter, ext_version" constraintName="ux_fill_quality_daily_key"/>
    </changeSet>
</databaseChangeLog>
