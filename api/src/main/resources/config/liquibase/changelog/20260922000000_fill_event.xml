<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Phase 10.1 — fill telemetry per ATS.

        One row per autofill run: which ATS family, which adapter handled it, and COUNTS — fields
        found, filled, failed, required left empty, corrected afterwards. Never a field value,
        never a label, never the page's hostname (the ATS is a fixed family like `workday` or
        `other`, enforced server-side), and deliberately NO user_id: this measures the engine,
        not people, so there is nothing here to link back to an account or to erase with one.

        The id is generated by the extension (a random UUID), so a later "the user corrected a
        field" signal can reference the fill without waiting for this row's round trip. It is the
        primary key, which also makes a retried insert a harmless collision.

        Additive; no data migration.
    -->
    <changeSet id="20260922000000-1" author="dossier">
        <createTable tableName="fill_event">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ats" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="adapter" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="fields_found" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fields_filled" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fields_failed" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="required_left_empty" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="user_corrected" type="integer" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ext_version" type="varchar(20)"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="fill_event" indexName="ix_fill_event_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
